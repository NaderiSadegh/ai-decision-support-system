# Default deterministic mode. Works in CI and local development without API keys.
LLM_PROVIDER=mock

# Optional local LLM mode. Requires Ollama running on your machine.
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional data/logging overrides.
OPS_ANALYST_DATA_DIR=data/synthetic
RETRIEVAL_TOP_K=5
LOG_LEVEL=INFO

